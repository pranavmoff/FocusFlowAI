# Server-side Supabase (used by createServerFn handlers and SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Client-side Supabase (exposed to the browser by Vite at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Canonical public site URL used for auth email redirects
VITE_SITE_URL=http://localhost:8081

# Direct Google Gemini API key (used by AI features)
GEMINI_API_KEY=
PORT=8081
